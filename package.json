{
  "name": "@mirafive/sdk-nuxt",
  "version": "1.0.0",
  "description": "MIRA FIVE SDK for Nuxt",
  "keywords": [
    "analytics",
    "cookieless",
    "gdpr",
    "mirafive",
    "nuxt",
    "nuxt-module",
    "privacy"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-nuxt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "nuxt-module-build build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "playground": "nuxt dev playground",
    "playground:verify": "bun scripts/verify-playground.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mirafive/sdk-browser": "^1.0.0",
    "@mirafive/sdk-server": "^1.0.0",
    "@mirafive/sdk-vue": "^1.0.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@types/node": "^26.6.5",
    "nuxt": "^4.5.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "@mirafive/sdk-browser": "^1.0.0",
    "@mirafive/sdk-server": "^1.0.0",
    "@mirafive/sdk-vue": "^1.0.0",
    "nuxt": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.4"
}
