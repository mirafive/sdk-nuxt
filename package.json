{
  "name": "@mirafive/nuxt",
  "version": "2.0.0",
  "description": "MIRA FIVE for Nuxt: one module line for consent-aware analytics, auto-imported useMira() and useServerMira(event), events sent after the response. No dependencies beyond MIRA FIVE's own.",
  "keywords": [
    "analytics",
    "attribution",
    "consent",
    "mira-five",
    "mirafive",
    "nitro",
    "nuxt",
    "nuxt-module",
    "vue"
  ],
  "homepage": "https://github.com/mirafive/sdk-nuxt#readme",
  "bugs": {
    "url": "https://github.com/mirafive/sdk-nuxt/issues"
  },
  "license": "MIT",
  "author": "Cloo GmbH <hallo@mirafive.io> (https://mirafive.io)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-nuxt.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime/plugin.js": {
      "types": "./dist/runtime/plugin.d.ts",
      "default": "./dist/runtime/plugin.js"
    },
    "./runtime/composables.js": {
      "types": "./dist/runtime/composables.d.ts",
      "default": "./dist/runtime/composables.js"
    },
    "./runtime/server.js": {
      "types": "./dist/runtime/server.d.ts",
      "default": "./dist/runtime/server.js"
    },
    "./runtime/nitro.js": {
      "types": "./dist/runtime/nitro.d.ts",
      "default": "./dist/runtime/nitro.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "bun run build.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "test": "bun test",
    "typecheck": "bun check"
  },
  "dependencies": {
    "@mirafive/node": "^2.0.0",
    "@mirafive/vue": "^2.0.0",
    "@mirafive/web": "^2.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "^7.0.2",
    "vue": "^3.5.45"
  },
  "peerDependencies": {
    "nuxt": ">=3.13"
  },
  "packageManager": "bun@1.4.4",
  "mira": {
    "external": [
      "#app",
      "#imports"
    ],
    "nodeLoad": false
  }
}
